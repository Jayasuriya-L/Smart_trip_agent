# ── SmartTrip-Agent Backend Environment Variables ──────────────
# Copy this file to .env and fill in your values

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL (used by Docker Compose)
POSTGRES_USER=smarttrip
POSTGRES_PASSWORD=smarttrip_secret
POSTGRES_DB=smarttrip_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full DB URL (auto-built from above in docker-compose, or set manually)
DATABASE_URL=postgresql+asyncpg://smarttrip:smarttrip_secret@db:5432/smarttrip_db

# App
APP_ENV=development
APP_SECRET_KEY=change_me_in_production
CORS_ORIGINS=http://localhost:3000
